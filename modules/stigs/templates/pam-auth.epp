<%- |
  Enum['system-auth', 'password-auth'] $pam_name,
  Integer                              $os_major,
  Integer                              $hash_rounds,
  Enum['required', 'requisite']        $pwquality_control,
  Enum['required', 'requisite']        $pwhistory_control,
  Integer[5]                           $password_history,
  Boolean                              $include_sssd_rules,
  Boolean                              $enable_smartcard,
  String                               $sssd_type_prefix,
| -%>
#%PAM-1.0
#
# <%= $pam_name %>
#
# Managed by Puppet.
# Manual changes will be replaced.
#
# RHEL major version: <%= $os_major %>
# Password hashing rounds: <%= $hash_rounds %>
#
auth        required                                     pam_env.so
<%# Four-second failed-authentication delay. %>
auth        required                                     pam_faildelay.so delay=4000000
<%#
# STIG: Check the account lock before authentication.
# This line must occur before pam_unix.so.
%>
auth        required                                     pam_faillock.so preauth silent
<% if $include_sssd_rules { %>
<%# Determine whether this is a regular user. %>
auth        [default=1 ignore=ignore success=ok]         pam_usertype.so isregular
<% if $enable_smartcard { %>
<%#
# Local users continue through the smart-card and local-password rules.
# Nonlocal users skip the next two rules and continue to the normal
# SSSD password-authentication rule.
%>
auth        [default=2 ignore=ignore success=ok]         pam_localuser.so
<%#
# Attempt SSSD smart-card authentication.
# Missing-module return codes are ignored so local password authentication
# remains available when pam_sss.so is not installed.
%>
<%= $sssd_type_prefix %>auth       [success=done authinfo_unavail=ignore user_unknown=ignore ignore=ignore open_err=ignore module_unknown=ignore default=die] pam_sss.so try_cert_auth
<% } else { %>
<%#
# Local users continue to pam_unix.so.
# Nonlocal users skip pam_unix.so.
%>
auth        [default=1 ignore=ignore success=ok]         pam_localuser.so
<% } %>
<%#
# Authenticate local users.
# STIG: Do not add nullok.
%>
auth        sufficient                                   pam_unix.so
<%# Avoid sending system accounts to SSSD. %>
auth        [default=1 ignore=ignore success=ok]         pam_usertype.so isregular
<%#
# Authenticate nonlocal users through SSSD.
# A leading "-" suppresses module-load errors when pam_sss.so is absent.
%>
<%= $sssd_type_prefix %>auth       sufficient                                   pam_sss.so forward_pass
<% } else { %>
<%#
# Local-only authentication.
# STIG: Do not add nullok.
%>
auth        sufficient                                   pam_unix.so
<% } %>
<%# STIG: Record an unsuccessful authentication attempt. %>
auth        required                                     pam_faillock.so authfail
<%# Deny authentication if no previous provider succeeded. %>
auth        required                                     pam_deny.so

<%# STIG: Enforce the pam_faillock account state. %>
account     required                                     pam_faillock.so
<%# Enforce local account expiration and access restrictions. %>
account     required                                     pam_unix.so
<% if $include_sssd_rules { %>
<%# Local and system accounts do not require an SSSD account check. %>
account     sufficient                                   pam_localuser.so
account     sufficient                                   pam_usertype.so issystem
<%# Check SSSD account authorization when available. %>
<%= $sssd_type_prefix %>account    [success=ok new_authtok_reqd=ok user_unknown=ignore authinfo_unavail=ignore open_err=ignore module_unknown=ignore ignore=ignore default=bad] pam_sss.so
account     required                                     pam_permit.so
<% } %>
<%#
# STIG:
#   RHEL 8:  password requisite pam_pwquality.so
#   RHEL 9:  password required  pam_pwquality.so
#   RHEL 10: password required  pam_pwquality.so
%>
password    <%= $pwquality_control %>                                    pam_pwquality.so<% if $include_sssd_rules { %> local_users_only<% } %>
<% if $include_sssd_rules { %>
<%#
# Apply local password history only to local accounts.
# Nonlocal accounts skip the following pam_pwhistory rule.
%>
password    [default=1 ignore=ignore success=ok]         pam_localuser.so
<% } %>
<%# Prevent reuse of recent local passwords. %>
password    <%= $pwhistory_control %>                                    pam_pwhistory.so use_authtok remember=<%= $password_history %> retry=3 enforce_for_root
<%#
# Site policy: SHA-512 with 100,000 rounds on RHEL 8, 9, and 10.
#
# Keep "sha512 rounds=N" together for scanner compatibility.
%>
password    sufficient                                   pam_unix.so sha512 rounds=<%= $hash_rounds %> shadow use_authtok
<% if $include_sssd_rules { %>
<%# Do not send a failed local password change to SSSD. %>
password    [success=1 default=ignore]                   pam_localuser.so
<%#  Update a nonlocal password through SSSD when available. %>
<%= $sssd_type_prefix %>password   sufficient                                   pam_sss.so use_authtok
<% } %>
password    required                                     pam_deny.so

session     optional                                     pam_keyinit.so revoke
session     required                                     pam_limits.so
<%# The leading "-" suppresses an error if pam_systemd.so is unavailable. %>
-session    optional                                     pam_systemd.so
<%#  Avoid opening a redundant pam_unix session for cron. %>
session     [success=1 default=ignore]                   pam_succeed_if.so service in crond quiet use_uid
session     required                                     pam_unix.so
<% if $include_sssd_rules { %>
<%= $sssd_type_prefix %>
session    optional                                      pam_sss.so
<% } %>
